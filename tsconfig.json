{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "paths": {
    "#lib": ["./src/lib/index.ts"],
    "#lib/*": ["./src/lib/*"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules/**", ".svelte-kit/**", "build/**"]
}
